#!/bin/sh

# Keep builds deterministic even when the host has an incompatible global
# Gradle version. This is a small self-contained wrapper for this project.
set -eu

distribution_url=$(sed -n 's/^distributionUrl=//p' gradle/wrapper/gradle-wrapper.properties | sed 's/\\:/:/g')
distribution_zip=${distribution_url##*/}
distribution_name=${distribution_zip%.zip}
gradle_home=${GRADLE_USER_HOME:-"$HOME/.gradle"}
gradle_dir="$gradle_home/tasbeh-wrapper/$distribution_name"

if [ ! -x "$gradle_dir/bin/gradle" ]; then
  temp_dir=$(mktemp -d)
  trap 'rm -rf "$temp_dir"' EXIT HUP INT TERM
  curl --fail --location --silent --show-error "$distribution_url" -o "$temp_dir/gradle.zip"
  unzip -q "$temp_dir/gradle.zip" -d "$temp_dir/extracted"
  mkdir -p "$gradle_home/tasbeh-wrapper"
  rm -rf "$gradle_dir"
  mv "$temp_dir/extracted/$distribution_name" "$gradle_dir"
fi

exec "$gradle_dir/bin/gradle" "$@"

